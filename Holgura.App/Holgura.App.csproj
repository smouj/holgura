<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>1.1.0</Version>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Holgura.App</RootNamespace>
    <AssemblyName>Holgura.App</AssemblyName>
    <StartupObject>Holgura.App.Program</StartupObject>
    <ApplicationIcon>..\assets\holgura.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\assets\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\assets\logo-light.png" Link="Assets\logo-light.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Holgura.Contracts\Holgura.Contracts.csproj" />
    <ProjectReference Include="..\Holgura.Core\Holgura.Core.csproj" />
    <ProjectReference Include="..\Holgura.Engine\Holgura.Engine.csproj" />
    <ProjectReference Include="..\Holgura.Platform.Windows\Holgura.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
