<Page x:Class="Holgura.App.Views.InstalledAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Aplicaciones"
      Background="Transparent"
      FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="ContentRoot" Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="APLICACIONES Y JUEGOS" Style="{StaticResource Kicker}" />
                <TextBlock Text="Lo que tienes instalado" Style="{StaticResource H1}" Margin="0,3,0,0" />
                <TextBlock Text="Revisa programas y juegos registrados por Windows. Holgura abre el desinstalador oficial y nunca borra carpetas de programas a mano."
                           Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="650" />
            </StackPanel>
            <Button Grid.Column="1" Content="Actualizar lista" Style="{StaticResource QuietButton}"
                    Click="OnRefreshClick" IsEnabled="{Binding CanRefresh}"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextInput}" VerticalContentAlignment="Center"
                         ToolTip="Buscar por nombre, editor o versión"
                         AutomationProperties.Name="Buscar aplicaciones instaladas" />
                <TextBlock Text="Buscar por nombre, editor o versión…" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tiny}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Margin" Value="12,0,8,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="1" ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding SortMode, Mode=TwoWay}"
                      Style="{StaticResource CompactComboBox}" Width="164" Margin="12,0,0,0"
                      ToolTip="Ordenar aplicaciones por tamaño o nombre" />
            <TextBlock Grid.Column="2" Text="{Binding VisibleCountText}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aplicaciones detectadas" Style="{StaticResource BodyStrong}" />
                        <Button Grid.Column="1" Content="Quitar selección" Style="{StaticResource LinkButton}"
                                Click="OnClearSelectionClick" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{Binding VisibleApplications}"
                              SelectedItem="{Binding CurrentApplication, Mode=TwoWay}"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource SelectableListItem}">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Margin" Value="0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="54" Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrong}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding PublisherText}" Style="{StaticResource Tiny}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PublisherText}" />
                                        <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Tiny}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="DETALLES" Style="{StaticResource Kicker}" />
                        <TextBlock Text="{Binding CurrentApplication.DisplayName, TargetNullValue='Detalles de la aplicación'}"
                                   Style="{StaticResource H2}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,18,0,14" VerticalAlignment="Top">
                        <TextBlock Text="{Binding SelectedDetailsText}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="Windows controla el proceso y solicita permisos si hacen falta. Revisa el asistente antes de confirmar cada desinstalación."
                                       Style="{StaticResource Tiny}" TextWrapping="Wrap" />
                        </Border>
                        <Button Content="{Binding UninstallButtonText}" Style="{StaticResource DangerButton}"
                                Click="OnUninstallClick" IsEnabled="{Binding CanUninstall}" />
                        <Button Content="Administrar apps de Microsoft Store" Style="{StaticResource LinkButton}"
                                Click="OnOpenWindowsAppsSettingsClick" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar Width="100" Height="5" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Page>
