<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Cleaner.App</RootNamespace>
    <AssemblyName>Cleaner.App</AssemblyName>
    <StartupObject>Cleaner.App.Program</StartupObject>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleaner.Contracts\Cleaner.Contracts.csproj" />
    <ProjectReference Include="..\Cleaner.Core\Cleaner.Core.csproj" />
    <ProjectReference Include="..\Cleaner.Engine\Cleaner.Engine.csproj" />
    <ProjectReference Include="..\Cleaner.Platform.Windows\Cleaner.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
