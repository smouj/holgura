<Page x:Class="Cleaner.App.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Historial"
      Background="Transparent"
      FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Historial" Style="{StaticResource H1}" />
            <TextBlock Text="Operaciones guardadas en este equipo. Las simulaciones se marcan como tales." Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding When}" Style="{StaticResource BodyStrong}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Tiny}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
